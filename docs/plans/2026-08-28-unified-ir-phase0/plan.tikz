% Unified IR — Phase 0: architecture and dataflow figures (TikZ)
% Created-at: 2026-08-28 17:35 CEST
%
% Standalone-includable. \input{plan.tikz} from plan.tex, which supplies the
% preamble. Requires: tikz, positioning, fit, backgrounds, arrows.meta, calc.

% ---------------------------------------------------------------------------
% Figure 1 — the duplication that blocks mutability.
%
% Drawn to make one thing visible: five arrays that must grow together on every
% declaration insert, with nothing in the type system coupling them, and every
% reader indexing densely rather than through .get().
% ---------------------------------------------------------------------------
\begin{tikzpicture}[
    font=\small,
    arena/.style={draw=black!70, fill=blue!6, rounded corners=2pt,
                  minimum width=3.1cm, minimum height=0.72cm, align=center},
    derived/.style={draw=red!60, fill=red!7, rounded corners=2pt, dashed,
                    minimum width=3.1cm, minimum height=0.72cm, align=center},
    side/.style={draw=orange!70, fill=orange!8, rounded corners=2pt,
                 minimum width=3.1cm, minimum height=0.72cm, align=center},
    lockstep/.style={-{Stealth[length=2mm]}, red!65, thick},
    rev/.style={-{Stealth[length=2mm]}, black!55},
    node distance=0.32cm and 1.5cm,
]

\node[arena] (decl)  {\texttt{decl\_nodes}\\[-1pt]\scriptsize authoritative arena};
\node[arena, below=of decl] (nodes) {\texttt{nodes}};
\node[arena, below=of nodes] (edges) {\texttt{edges}};
\node[arena, below=of edges] (arcs)  {\texttt{arcs}};

\node[derived, right=of decl]  (d2n) {\texttt{decl\_to\_node}\\[-1pt]\scriptsize $\mathrm{Vec}\langle \mathrm{Option}\langle \mathrm{NodeId}\rangle\rangle$};
\node[derived, below=of d2n]   (d2e) {\texttt{decl\_to\_edge}};
\node[derived, below=of d2e]   (d2a) {\texttt{decl\_to\_arc}};
\node[side,    below=of d2a]   (dh)  {\texttt{decl\_hash}};
\node[side,    below=of dh]    (ah)  {\texttt{arc\_hash}};

% The lockstep obligation: one insert, five pushes, zero enforcement.
\draw[lockstep] (decl.east) -- (d2n.west);
\draw[lockstep] (decl.east) to[out=-20,in=180] (d2e.west);
\draw[lockstep] (decl.east) to[out=-35,in=180] (d2a.west);
\draw[lockstep] (decl.east) to[out=-45,in=180] (dh.west);

% The reverse edges that already encode the same fact.
\draw[rev] (nodes.west) to[out=170,in=190] node[left,scriptsize,align=right]
      {\texttt{NodeRec.decl}} (decl.west);
\draw[rev] (edges.west) to[out=170,in=200] (decl.west);
\draw[rev] (arcs.west)  to[out=170,in=210] node[left,scriptsize,align=right,pos=0.35]
      {\texttt{ArcRec.in\_edge}\\(\emph{not} the inverse)} (decl.west);

\draw[rev] (edges.east) to[out=-10,in=10] node[right,scriptsize,align=left,pos=0.5]
      {\texttt{EdgeRec.arcs}\\\scriptsize type mismatch:\\\scriptsize fwd \texttt{HyperArcId},\\\scriptsize back \texttt{DeclId}} (arcs.east);
\draw[lockstep] (arcs.east) to[out=25,in=200] (ah.west);

\node[align=left, anchor=north west, font=\scriptsize, text width=6.2cm]
      at ($(ah.south west)+(0,-0.5)$)
      {\textbf{Red, dashed}: derived state that duplicates a fact already stored.
       Measured at 20\,001 decls / 5\,000 arcs: derived $=1\,785\,081$\,B against
       record tables $=2\,920\,096$\,B, i.e.\ \textbf{61.1\%}. Half of
       \texttt{decl\_to\_*} is niche waste --- \texttt{Id} has no niche, so
       $\mathrm{size\_of}\langle\mathrm{Option}\langle\mathrm{NodeId}\rangle\rangle=16$
       while $\mathrm{size\_of}\langle\mathrm{NodeId}\rangle=8$.};

\end{tikzpicture}

% ---------------------------------------------------------------------------
% Figure 2 — target end state, and where fidelity is lost today.
%
% The asymmetry this figure exists to show: `bases` survives the text emitter
% and is silently dropped by the editor bridge. Two consumers of one IR, two
% different fidelities, and only one of them documents its losses.
% ---------------------------------------------------------------------------
\begin{tikzpicture}[
    font=\small,
    box/.style={draw=black!70, rounded corners=2pt, minimum height=0.8cm,
                minimum width=2.7cm, align=center},
    canon/.style={box, fill=green!8, draw=green!45!black, very thick},
    view/.style={box, fill=blue!5},
    lossy/.style={-{Stealth[length=2mm]}, red!70, thick, dashed},
    ok/.style={-{Stealth[length=2mm]}, black!65},
    node distance=1.0cm and 1.7cm,
]

\node[canon] (ir) {\textbf{canonical \texttt{Ir}}\\[-2pt]\scriptsize mutable, stably keyed\\[-2pt]\scriptsize single source of truth};

\node[view, above left=1.2cm and 1.9cm of ir]  (parser) {\texttt{parser}\\[-2pt]\scriptsize 0 ID references};
\node[view, above right=1.2cm and 1.9cm of ir] (stream) {IR stream\\[-2pt]\scriptsize 10A codec + 10B1\\[-2pt]\scriptsize assembler};

\node[view, below left=1.3cm and 2.6cm of ir]  (text)   {\texttt{emit\_hymeko}\\[-2pt]\scriptsize text emitter};
\node[view, below=1.3cm of ir]                 (bridge) {\texttt{bridge.rs}\\[-2pt]\scriptsize editor bridge};
\node[view, below right=1.3cm and 2.6cm of ir] (views)  {derived views\\[-2pt]\scriptsize COO / CSR / incidence\\[-2pt]\scriptsize Laplacians, GPU};

\draw[ok] (parser) -- node[above left,scriptsize]{lowering} (ir);
\draw[ok] (stream) -- node[above right,scriptsize]{transactions} (ir);
\draw[ok] (ir) -- node[left,scriptsize,pos=0.45]{\texttt{bases} kept} (text);
\draw[ok] (ir) -- node[right,scriptsize,pos=0.45]{versioned, rebuildable} (views);
\draw[lossy] (ir) -- node[right,scriptsize,align=left,pos=0.35]
      {\textbf{drops \texttt{bases}}\\\textbf{drops \texttt{AnnoR}}\\\scriptsize (both undocumented)\\\scriptsize N arcs $\to$ 1 list\\\scriptsize weights $\to$ hardcoded 1.0} (bridge);

\node[align=left, anchor=north west, font=\scriptsize, text width=7.4cm]
      at ($(bridge.south west)+(-2.2,-0.55)$)
      {\textbf{Red, dashed} is the lossy path. The same field (\texttt{bases},
       i.e.\ inheritance) survives \texttt{emit\_hymeko} and is discarded by
       \texttt{bridge.rs} --- measured by occurrence count: \textbf{0} mentions
       in the bridge, and it is absent from the bridge's own documented list of
       losses. M5 deletes this path rather than repairing it: once \texttt{Ir}
       is mutable and stably keyed, a second mutable model has no reason to
       exist.};

\end{tikzpicture}
