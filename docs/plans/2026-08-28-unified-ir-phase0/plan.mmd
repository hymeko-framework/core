%% ---------------------------------------------------------------------------
%% View 1 — migration sequence. The colour split is the whole point:
%% green stages touch one repository, amber stages fan out, red is the gate
%% that must be green before the representation may change.
%% ---------------------------------------------------------------------------
graph TD
    subgraph REPAIR["M0 — repairs (no representation change)"]
        M01["M0.1 Batch: fix the doc now,<br/>atomicity in M4 (validate-then-commit<br/>makes it free — no second mechanism)"]
        M04["M0.4 Ir::validate — the oracle,<br/>written while Ir is still correct"]
        M05["M0.5 canonical-hash invariance test<br/>(correctness — needs no quiet host)"]
        M0J["M0.x schema_version on the JSON DTO<br/>free now, expensive later"]
    end

    M2A["M2a — add accessors<br/>purely additive · core-local<br/>push_declaration removes the<br/>SECOND lockstep writer in bridge.rs"]
    M2B["M2b — migrate 196 call sites<br/>PER REPOSITORY, independently landable<br/>core 52 · hnn 6 · misc 11 · transformation 127"]
    M2C["M2c — seal direct access<br/>remove From&lt;usize&gt; + pub .0 (D4)<br/>⛔ POINT OF NO RETURN"]
    M2D["M2d — collapse derived mappings<br/>3 maps → inline PayloadIdx<br/>5 lockstep arrays → 2"]
    M1["M1 — ID representation<br/>NonZeroU32 niche · type tag<br/>✅ CORE-LOCAL, because of M2b"]
    M3["M3 — generational keys, mutability<br/>needs the 580-entry order column triaged"]
    M4["M4 — transactions<br/>txn-local IDs · validation overlay<br/>infallible commit · atomic Batch"]
    M5["M5 — bridge removal<br/>gated on SIX criteria (§J.5)"]

    EXIST["ALREADY BUILT — do not rebuild<br/>Phase 10A wire codec<br/>Phase 10B1 assembler:<br/>content-aware replay, O(1) window,<br/>conflict detection"]

    REPAIR --> M2A --> M2B --> M2C --> M2D --> M1 --> M3 --> M4 --> M5
    M04 -.oracle for.-> M2D
    M04 -.oracle for.-> M3
    M05 -.safety net for.-> M3
    M0J -.must ship before.-> M1
    EXIST -.attaches to.-> M4

    classDef local fill:#e8f4ea,stroke:#2f6b3f,color:#12301c
    classDef fanout fill:#fff4e0,stroke:#b8791a,color:#4a3010
    classDef gate fill:#fdeaea,stroke:#a33,color:#4a1414
