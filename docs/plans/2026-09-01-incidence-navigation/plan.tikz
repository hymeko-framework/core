% Canonical reverse-incidence navigation (TikZ).
\begin{tikzpicture}[font=\small,node distance=6mm,
  b/.style={draw,rounded corners,align=center,inner sep=3pt},
  new/.style={b,fill=blue!8},keep/.style={b,fill=green!10},gone/.style={b,fill=red!8}]
  \node[keep] (ir) {Ir (canonical hypergraph)\edge -> arc -> ref -> target};
  \node[new,below=7mm of ir] (rev) {build\_incidence\_index(\&Ir)\CSR: DeclId -> incident HyperArcIds\lossless, derived, O(inc)};
  \node[new,below=7mm of rev] (nav) {incident\_arcs(node) -> \&[HyperArcId]\+ degree/incidence\_count/bytes};
  \node[gone,right=12mm of rev] (dense) {dense/star/clique CSR\13x memory, quadratic\lossy pairwise -- AVOIDED};
  \node[gone,right=12mm of nav] (scan) {no-index scan\O(V*E) ~650x -- REJECTED};
  \draw[->] (ir)--(rev); \draw[->] (rev)--(nav);
  \draw[->,dashed] (ir.east)-|(dense) node[near start,above,font=\tiny]{control};
  \node[keep,below=6mm of nav,text width=60mm]{hymeko_graph algorithms (next repo): berge_bfs / reachable / connected_components on incident_arcs};
\end{tikzpicture}
