\begin{tikzpicture}[
  node distance=8mm and 12mm,
  box/.style={draw, rounded corners, align=center, minimum height=8mm, text width=30mm},
  core/.style={box, fill=blue!12, very thick},
  derived/.style={box, fill=green!12},
  endpoint/.style={box, fill=orange!15},
  phase/.style={box, fill=gray!12, text width=24mm},
  arrow/.style={-{Latex[length=2mm]}, thick}
]
\node[box] (source) {HyMeKo source};
\node[box, right=of source] (parser) {parser + lowering};
\node[core, right=of parser] (ir) {one canonical \texttt{Ir}};
\node[derived, above right=of ir] (inc) {exact sparse\\incidence index};
\node[derived, right=of inc] (ops) {$B$, $B^T$, $B^TB$};
\node[endpoint, above right=of ops] (compute) {CPU / Rayon /\\WGPU / CUDA / FPGA};
\node[endpoint, below right=of ops] (graph) {direct-IR\\graph algorithms};
\node[derived, below right=of ir] (snapshot) {immutable versioned\\snapshot};
\node[derived, right=of snapshot] (stream) {\texttt{ir\_stream}\\sections};
\node[endpoint, below right=of stream] (mcu) {MCU C view /\\replica};
\node[endpoint, above right=of stream] (webxr) {WebXR query /\\Nagare HNN};

\draw[arrow] (source) -- (parser);
\draw[arrow] (parser) -- (ir);
\draw[arrow] (ir) -- (inc);
\draw[arrow] (inc) -- (ops);
\draw[arrow] (ops) -- (compute);
\draw[arrow] (inc) -- (graph);
\draw[arrow] (ir) -- (snapshot);
\draw[arrow] (snapshot) -- (stream);
\draw[arrow] (stream) -- (mcu);
\draw[arrow] (ir) -- (webxr);

\node[phase, below=20mm of source] (p0) {P0 evidence};
\node[phase, right=of p0] (p1) {P1 benchmark};
\node[phase, right=of p1] (p24) {P2--P4 perf + storage};
\node[phase, right=of p24] (p57) {P5--P7 dynamic};
\node[phase, right=of p57] (p811) {P8--P11 endpoints};
\draw[arrow] (p0) -- (p1);
\draw[arrow] (p1) -- (p24);
\draw[arrow] (p24) -- (p57);
\draw[arrow] (p57) -- (p811);
\end{tikzpicture}
