% \input{plan.tikz} from plan.tex, which supplies the preamble.

% ---------------------------------------------------------------------------
% Figure 1 — the V&V split, and why it is not decorative.
% ---------------------------------------------------------------------------
\begin{tikzpicture}[
    font=\small,
    lay/.style={draw=black!70, rounded corners=3pt, minimum width=5.0cm,
                minimum height=1.05cm, align=center},
    sup/.style={lay, fill=blue!6},
    ver/.style={lay, fill=green!8, draw=green!45!black},
    val/.style={lay, fill=orange!8, draw=orange!70},
    a/.style={-{Stealth[length=2mm]}, black!65},
    node distance=0.55cm and 2.0cm,
]
\node[sup] (s) {\textbf{support}\\[-2pt]\scriptsize builder · oracle · corpus --- \emph{no tests}};
\node[ver, below left=1.2cm and 0.6cm of s] (v)
      {\textbf{verification}\\[-2pt]\scriptsize does it meet its specification?\\[-2pt]\scriptsize synthetic inputs, known answers};
\node[val, below right=1.2cm and 0.6cm of s] (a)
      {\textbf{validation}\\[-2pt]\scriptsize does it hold on real programs\\[-2pt]\scriptsize and for real consumers?};
\draw[a] (s) -- (v);
\draw[a] (s) -- (a);

\node[align=left, anchor=north west, font=\scriptsize, text width=11.2cm]
      at ($(v.south west)+(0,-0.6)$)
      {The split carries information. A \textbf{verification} pass with a
       \textbf{validation} failure means the \emph{specification} is wrong; the
       reverse means the \emph{implementation} is. Collapsing the two into one
       ``tests'' directory discards that signal --- which is what a
       phase-numbered layout does as soon as the phase ends.};
\end{tikzpicture}

% ---------------------------------------------------------------------------
% Figure 2 — what coverage does not tell you.
%
% All four mutants were planted in code that line coverage already reported as
% executed. Coverage located none of them.
% ---------------------------------------------------------------------------
\begin{tikzpicture}[
    font=\small,
    cell/.style={draw=black!60, minimum width=3.5cm, minimum height=0.7cm, align=center},
    covd/.style={cell, fill=green!10},
    mut/.style={cell, fill=red!10, draw=red!60},
    cau/.style={cell, fill=blue!8},
    node distance=0.18cm and 0.9cm,
]
\node[covd] (c1) {backlink validation\\[-3pt]\scriptsize 94.6\,\% covered};
\node[covd, below=of c1] (c2) {child iterator\\[-3pt]\scriptsize 94.6\,\% covered};
\node[covd, below=of c2] (c3) {\code{arc\_for\_decl}\\[-3pt]\scriptsize 94.6\,\% covered};
\node[covd, below=of c3] (c4) {iterator id mapping\\[-3pt]\scriptsize 94.6\,\% covered};

\node[mut, right=of c1] (m1) {defect injected};
\node[mut, right=of c2] (m2) {defect injected};
\node[mut, right=of c3] (m3) {defect injected};
\node[mut, right=of c4] (m4) {defect injected};

\node[cau, right=of m1] (k1) {caught by \textbf{2} tests};
\node[cau, right=of m2] (k2) {caught by \textbf{4} tests};
\node[cau, right=of m3] (k3) {caught by \textbf{1} test \ding{55}};
\node[cau, right=of m4] (k4) {caught by \textbf{5} tests};

\foreach \i in {1,2,3,4} {
  \draw[-{Stealth[length=1.6mm]}, black!55] (c\i) -- (m\i);
  \draw[-{Stealth[length=1.6mm]}, black!55] (m\i) -- (k\i);
}

\node[align=left, anchor=north west, font=\scriptsize, text width=11.6cm]
      at ($(k4.south west)+(-8.0,-0.5)$)
      {Every mutant was planted in code line coverage already called executed.
       The third --- conflating the map-only and checked-composite contracts ---
       was caught by a \emph{single} test, and that one depended on the corpus
       being present. A focused guard was added and the mutation re-run before
       proceeding. \textbf{Coverage located none of these; the mutations did.}};
\end{tikzpicture}
