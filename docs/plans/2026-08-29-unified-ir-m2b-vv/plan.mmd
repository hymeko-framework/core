        B1["unified_ir_m05/<br/>builder · oracle · invariance · depth"]
        B2["unified_ir_m06/<br/>coverage · frozen_v1 · coherence_tests"]
        B3["unified_ir_m2a/<br/>accessors · sentinel"]
