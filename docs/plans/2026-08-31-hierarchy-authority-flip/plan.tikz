% U2.2 authority flip (TikZ).
\begin{tikzpicture}[font=\small,node distance=6mm,
  b/.style={draw,rounded corners,align=center,inner sep=3pt},
  gone/.style={b,fill=red!8},new/.style={b,fill=blue!8},keep/.style={b,fill=green!10}]
  \node[keep] (ir) {Ir = links + namespace\_roots\SOLE authority};
  \node[gone,right=12mm of ir] (idx) {resolution Index\non-authoritative\(compat, deprecated use)};
  \node[new,below=7mm of ir] (hash) {canonical\_program\_hash(cfg, ir, it)\no Index arg};
  \node[new,right=10mm of hash] (dpi) {build\_path\_index(\&Ir)\-> DerivedPathIndex};
  \node[b,below=7mm of hash] (mstore) {compile: lower -> merkle ->\validate\_namespace\_roots ONCE\-> hash from Ir};
  \node[new,right=8mm of mstore] (pp) {pretty\_print uses\DerivedPathIndex};
  \draw[->] (ir)--(hash); \draw[->,dashed] (idx.south)--(mstore.east) node[midway,right,font=\tiny]{once};
  \draw[->] (ir)--(dpi); \draw[->] (dpi)--(pp); \draw[->] (hash)--(mstore);
  \node[keep,below=6mm of mstore,text width=58mm]{hash -14..-26\% (Index prefix-HashMap pass gone); bit-identical; compile no regression};
\end{tikzpicture}
