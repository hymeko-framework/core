    L[Separate latency pass: sampled RDTSC probe] --> A
    A --> J[Sidecar JSON + Criterion sample.json]
    J --> S[summarize.py: median, IQR, worst, percentiles, plots]
  end
  B[Mutex VecDeque baseline, same semantics] -.-> R
  M -.-> Q
