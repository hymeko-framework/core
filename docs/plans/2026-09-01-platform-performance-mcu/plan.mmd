%% Platform performance survey + MCU architecture — flow and profiles.

graph TD
  src["*.hymeko source"] --> parser["RealParser + ModuleStore"]
  parser --> ir["canonical hymeko_core::ir::Ir (one model)"]
  ir --> snap["validated sectioned snapshot (ir_stream: envelope + sections)"]
  snap -->|host| host_q["host queries / operators / validators (benched)"]
  snap -->|MCU-RO| ro["read-only view over flash: zero-heap sparse queries"]
  snap -->|MCU-DYNAMIC| dyn["fixed-arena Begin/Chunk/Commit/Abort + atomic swap"]
  snap -->|MCU-HOSTED| hosted["RTOS/Linux-class edge runtime"]
  ir -. NOT the MCU path .-> serde["serde/JSON: usize IDs + tagged enums (not portable)"]
  cbor["CborPayload: dormant full-copy — NOT adopted"]:::rej
  classDef rej fill:#fdd,stroke:#c33;

%% measurement phases (never cross-compared)
graph LR
  cold[cold: parse+lower+build+op] --> prepared[prepared: op only]
  prepared --> resident[resident: repeat, no realloc]
  resident --> e2e[end-to-end: source to result]
