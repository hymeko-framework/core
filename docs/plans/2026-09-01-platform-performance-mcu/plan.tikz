% MCU canonical-IR: one semantic Ir, several validated storage/transport profiles. Standalone.
\documentclass[tikz,border=6pt]{standalone}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds}
\begin{document}
\begin{tikzpicture}[font=\small,
  box/.style={draw,rounded corners,align=center,minimum height=8mm},
  ir/.style={box,fill=blue!10}, prof/.style={box,fill=green!10}, rej/.style={box,fill=red!8,dashed},
  e/.style={-{Stealth[length=2mm]}}]
  \node[box,fill=gray!10] (src) {\texttt{*.hymeko} source (host only)};
  \node[ir,below=7mm of src] (ir) {canonical \texttt{ir::Ir}\\one semantic model};
  \node[ir,below=7mm of ir] (snap) {validated sectioned snapshot\\(ir\_stream envelope + sections;\\little-endian, no usize, digest)};
  \node[prof,below left=10mm and 10mm of snap] (ro) {MCU-RO\\flash view, zero heap,\\sparse queries};
  \node[prof,below=10mm of snap] (dyn) {MCU-DYNAMIC\\fixed arena,\\Begin/Chunk/Commit};
  \node[prof,below right=10mm and 10mm of snap] (hosted) {MCU-HOSTED\\RTOS/Linux edge};
  \node[rej,right=14mm of snap] (cbor) {CborPayload (dormant,\\full-copy) --- NOT adopted};
  \draw[e] (src) -- (ir); \draw[e] (ir) -- (snap) node[midway,right,font=\scriptsize]{host: parser+lowering};
  \draw[e] (snap) -- (ro); \draw[e] (snap) -- (dyn); \draw[e] (snap) -- (hosted);
  \draw[e,red,dashed] (snap) -- (cbor) node[midway,above,font=\scriptsize]{duplicate schema};
  \begin{scope}[on background layer]
    \node[draw,dashed,fit=(ro)(dyn)(hosted),inner sep=3mm,label=below:{same canonical semantics; profiles restrict, never reinterpret}] {};
  \end{scope}
\end{tikzpicture}
\end{document}
