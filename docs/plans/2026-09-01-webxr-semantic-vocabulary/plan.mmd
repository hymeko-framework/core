%% WebXR semantic vocabulary — structure + validation flow.

%% (1) Vocabulary two-layer <isa>
graph TD
  ce[cognitive_entity]
  sf[spatial_frame] --> ce
  pc[perceptual] --> ce
  ch[channel] --> ce
  node --> sf
  reference_space --> sf
  anchor --> sf
  geometry --> pc
  appearance --> pc
  light --> pc
  viewpoint --> ch
  input_source --> ch

%% (2) Source-first validation
sequenceDiagram
  participant S as webxr_scene_demo.hymeko
  participant V as webxr_vocabulary.hymeko (imported)
  participant P as RealParser + ModuleStore
  participant I as canonical Ir
  participant D as validate_scene(ir, it)
  S->>P: compile (imports V)
  P->>I: canonical Ir (scene + vocabulary)
  I->>D: read back (bases, attrs, containment)
  D-->>D: every element isa a known kind; required attrs; anchor in reference_space; two-layer isa
  D-->>S: [] (valid)  |  [Violation...] (rejected)
