% 2026-10-11: profile merged Core with the existing Criterion workloads;
% keep CPU sampling separate from repeated latency and peak-working-set results.
% Second optimization: borrow Index paths, retain all hierarchy checks and report ordering.
% Third optimization: share immutable Interner data; detach on writes and retain only live strings.
% Shared IR: owned construction -> shared published tables -> detach on first mutation.
\begin{tikzpicture}[node distance=5mm, every node/.style={draw,rounded corners,font=\small},>=Stealth]
\node (s) {Source (generation excluded)};
\node (p) [below=of s] {Parse and intern; resolve constants};
\node (c) [below=of p] {Borrow cached root AST and dependencies};
\node (i) [below=of c] {CanonicalPaths and CanonHashCfg own shared preparation};
\node (h) [below=of i] {CanonicalIncidence / CanonicalPrufer; bottom-up fold};
\node (t) [below=of h] {PruferTraversal: Iterator over leaf elimination};
\node (o) [right=of h,text width=32mm] {Output trait: bytes / buffered BLAKE3};
\node (v) [right=of i,text width=32mm] {NamespaceValidator borrows canonical paths};
\node (r) [below=of t] {Cached compiled program; prepared execution};
\draw[->] (s)--(p); \draw[->] (p)--(c); \draw[->] (c)--(i);
\draw[->] (i)--(h); \draw[->] (h)--(t); \draw[->] (t)--(r);
\draw[->] (h)--(o);
\draw[->] (i)--(v);
\end{tikzpicture}

\begin{tikzpicture}[node distance=5mm, every node/.style={draw,rounded corners,font=\small},>=Stealth]
\node (refs) {SignedRefR::target/sign own reference access};
\node (limits) [below=of refs] {Seven staging-limit guards};
\node (error) [below=of limits] {Assembler apply owns resync cleanup};
\node (keep) [below=of error] {Committed version and replay position preserved};
\draw[->] (limits)--(error); \draw[->] (error)--(keep);
\end{tikzpicture}

\begin{tikzpicture}[node distance=5mm, every node/.style={draw,rounded corners,font=\small},>=Stealth]
\node (clients) {Envelope, section and snapshot decoding};
\node (reader) [below=of clients] {LittleEndianReader::read<T>};
\node (value) [below=of reader] {LittleEndianValue: fixed byte array and static conversion};
\draw[->] (clients)--(reader); \draw[->] (reader)--(value);
\end{tikzpicture}

