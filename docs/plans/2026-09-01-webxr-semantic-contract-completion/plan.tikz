\documentclass[tikz,border=6pt]{standalone}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds}
\begin{document}\begin{tikzpicture}[font=\small,
 b/.style={draw,rounded corners,align=center,minimum height=8mm},
 sp/.style={b,fill=blue!8}, xr/.style={b,fill=green!10}, v/.style={b,fill=orange!10},
 e/.style={-{Stealth[length=2mm]}}]
 \node[sp] (spat) {\textbf{meta\_spatial}\scene / spatial\_frame / spatial\_entity / visual\_asset /\appearance / semantic\_anchor / affordance / action / input\_role\@placement @parent\_frame @anchoring @interaction @effect\pose: position[xyz] orientation[xyzw] scale[sss] (m, right-handed, -Z fwd)};
 \node[xr,below=10mm of spat] (xrv) {\textbf{meta\_webxr} (imports meta\_spatial)\session mode {inline,immersive-vr,immersive-ar}\reference space {viewer,local,local-floor,bounded-floor,unbounded}\capability {hit-test,hand-tracking,dom-overlay | anchors,layers(draft)} req/opt/runtime\input {gaze,pointer,controller,hands} · action {select,grab,release,...}};
 \node[b,below=10mm of xrv,fill=gray!8] (ir) {canonical hymeko\_core::ir::Ir (one model, no bridge)};
 \node[v,right=16mm of ir] (val) {\textbf{src/webxr::validate}\accessor-based, cycle-safe,\bounded, canonical-ID errors};
 \node[b,above=10mm of val,fill=yellow!12] (demo) {webxr\_hypergraph\_demo.hymeko\service network as spatial hypergraph};
 \draw[e] (spat) -- (xrv) node[midway,right,font=\scriptsize]{import + specialize};
 \draw[e] (xrv) -- (ir); \draw[e] (demo) -- (ir) node[midway,right,font=\scriptsize]{RealParser+compile};
 \draw[e] (ir) -- (val) node[midway,above,font=\scriptsize]{\&Ir + \&Interner};
\end{tikzpicture}\end{document}
