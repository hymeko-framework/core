\begin{center}
\begin{tikzpicture}[node distance=8mm, every node/.style={draw,align=center,rounded corners,font=\small}, >=Stealth]
\node (model) {Existing Lean model\\Replay safety and bounded oracle};
\node[below=of model] (rust) {Real Rust wire and assembler\\Conformance and outcome preflight};
\node[below left=10mm and 3mm of rust] (local) {Windows native};
\node[below=of rust] (linux) {Amaterasu native};
\node[below right=10mm and 3mm of rust] (arm) {Docker/QEMU ARM64};
\node[below=19mm of linux] (report) {Identical workloads and locked source\\Raw samples, RSS, scoped conclusions};
\draw[->] (model)--(rust); \draw[->] (rust)--(local); \draw[->] (rust)--(linux); \draw[->] (rust)--(arm);
\draw[->] (local)--(report); \draw[->] (linux)--(report); \draw[->] (arm)--(report);
\end{tikzpicture}
\end{center}
\begin{center}
\begin{tikzpicture}[node distance=10mm, every node/.style={draw,rounded corners,align=center,font=\small}, >=Stealth]
\node (workers) {Concurrent preparation\\existing ModuleStore per worker};
\node (commit) [below=of workers] {Check base and publish Arc\\short serialized critical section};
\node (readers) [below=of commit] {Concurrent readers\\immutable IR + interner + local revision};
\draw[->] (workers) -- (commit);
\draw[->] (commit) -- (readers);
\end{tikzpicture}
\end{center}
