\begin{tikzpicture}[node distance=16mm and 18mm, every node/.style={draw,rounded corners,align=center}]
  \node (source) {latest WebXR\\working tree};
  \node[right=of source] (webxr) {transformation\\\texttt{hymeko\_webxr}};
  \node[above=of webxr] (core) {core\\generic IR only};
