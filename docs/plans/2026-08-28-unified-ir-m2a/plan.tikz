% Unified IR M2a — accessor boundary (TikZ). Created-at: 2026-08-28 21:41 CEST
% \input{plan.tikz} from plan.tex, which supplies the preamble.
\begin{tikzpicture}[
    font=\small,
    api/.style={draw=green!45!black, fill=green!8, rounded corners=2pt,
                minimum width=3.6cm, minimum height=0.62cm, align=center},
    raw/.style={draw=red!60, fill=red!7, rounded corners=2pt, dashed,
                minimum width=3.6cm, minimum height=0.62cm, align=center},
    store/.style={draw=black!70, fill=blue!6, rounded corners=2pt,
                  minimum width=4.2cm, minimum height=0.9cm, align=center},
    bnd/.style={draw=orange!75, fill=orange!10, very thick, rounded corners=3pt,
                minimum width=4.6cm, minimum height=1.0cm, align=center},
    a/.style={-{Stealth[length=2mm]}, black!65},
    node distance=0.28cm and 1.6cm,
]
\node[api] (a1) {\texttt{decl\_node(d)}};
\node[api, below=of a1] (a2) {\texttt{node(n)} / \texttt{edge(e)} / \texttt{arc(a)}};
\node[api, below=of a2] (a3) {\texttt{node\_for\_decl(d)}};
\node[api, below=of a3] (a4) {\texttt{decls()} / \texttt{node\_records()}};
\node[api, below=of a4] (a5) {\texttt{kind\_of} / \texttt{parent\_of} / \texttt{child\_decls}};

\node[bnd, right=of a3] (b) {\textbf{ir/access.rs}\[-2pt]\scriptsize ordinal indexing\[-3pt]\scriptsize lives \emph{only} here};
\node[store, right=of b] (s) {current storage\[-2pt]\scriptsize \texttt{Vec}, dense ids\[-2pt]\scriptsize \emph{free to change in M2d/M1/M3}};

\foreach \x in {a1,a2,a3,a4,a5} \draw[a] (\x.east) -- (b.west);
\draw[a] (b) -- (s);

\node[raw, below=1.5cm of a5] (r) {\texttt{ir.decl\_nodes[d.0]}};
\draw[a, red!65, dashed] (r.east) to[out=0,in=250] (s.south);

\node[align=left, anchor=north west, font=\scriptsize, text width=9.2cm]
      at ($(r.south west)+(0,-0.45)$)
      {\textbf{Red, dashed} is the path M2b removes: 196 sites that name storage
       directly. \textbf{Green} contracts assume no dense ids, no ordinal
       stability, no absence of tombstones and no parallel maps --- a
       generational arena satisfies them by skipping vacant slots, with no
       call-site change. Measured cost of the boundary: \textbf{+20--49\,\%} on
       scalar lookup ($\approx$0.17\,ns), \textbf{within noise} on iteration.};
\end{tikzpicture}
