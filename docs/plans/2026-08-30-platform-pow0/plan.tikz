\begin{tikzpicture}[>=Stealth,node distance=5.5mm and 9mm,
  b/.style={draw,rounded corners,align=center,font=\scriptsize,minimum height=6mm}]
  \node[b,fill=blue!8](src){HyMeKo\source};
  \node[b,fill=blue!8,right=of src](ir){RealParser\+lower $\to$ Ir};
  \node[b,fill=blue!8,right=of ir](coh){coherence\+ canon hash};
  \node[b,fill=green!8,right=of coh](view){HyperGraph\View};
  \node[b,fill=green!8,below=of view](csr){star CSR};
  \node[b,fill=orange!10,left=of csr](cpu){CPU SpMM\serial+Rayon};
  \node[b,fill=orange!10,left=of cpu](gpu){WGPU resident\SpMM+act};
  \node[b,fill=blue!8,left=of gpu](eq){readback\= equivalence};
  \draw[->](src)--(ir);\draw[->](ir)--(coh);\draw[->](coh)--(view);
  \draw[->](view)--(csr);\draw[->](csr)--(cpu);\draw[->](cpu)--(gpu);\draw[->](gpu)--(eq);
\end{tikzpicture}
