\node[below=of sim] (scene) {Presentation\\scene/model};
\draw[->] (core)--(graph);
\draw[->] (core)--(transport);
\draw[->] (transport)--(sim);
\draw[->] (sim)--(trans);
\draw[->] (trans)--(scene);
\draw[->] (sim)--(scene);
\end{tikzpicture}

