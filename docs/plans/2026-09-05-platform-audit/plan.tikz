\begin{tikzpicture}[node distance=9mm, every node/.style={draw,rounded corners,align=center,font=\small},>=Stealth]
\node (core) {Core\\canonical Ir + CBOR};
\node[right=18mm of core] (graph) {Graph\\incidence algorithms};
\node[below=of core] (transport) {Chordex\\opaque bytes};
\node[below=of transport] (sim) {Simulator\\decode + retained Ir};
