%% Canonical CBOR snapshot over ir_stream: message sequence and consumer checks.
sequenceDiagram
    autonumber
    participant P as Producer (HIVE host / core_cpp tool)
    participant W as cbor_writer (encode_compiled, encode_snapshot_messages)
    participant T as Transport (Zenoh / UART link)
    participant V as ir_stream::validate_message
    participant A as TransactionAssembler
    participant D as cbor_writer::decode_snapshot

    P->>W: CompiledProgram + interner
    W-->>P: canonical CBOR bytes
    P->>W: encode_snapshot_messages(cbor, draft)
    W-->>P: SnapshotBegin, SnapshotChunk x n (CanonicalIrCbor, Raw8), Commit
    loop every message
        P->>T: bytes
        T->>V: bytes
        V->>A: ValidatedMessage (digest, table, limits)
        A-->>T: Accepted | ResyncRequired | ...
    end
    A->>D: Committed(CommittedTransaction)
    alt kind != Snapshot or no sections or foreign section or not Raw8 or too large
        D-->>P: CborStreamError (nothing published)
    else concatenate fragments in staging order
        D->>D: cbor_writer::decode(document, limits)
        D-->>P: DecodedCborPayload (validated IR, interner, canonical hash)
    end
