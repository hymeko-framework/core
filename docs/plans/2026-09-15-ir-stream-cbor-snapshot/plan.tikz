\begin{tikzpicture}[
  box/.style={draw, rounded corners, align=center, minimum height=11mm, text width=34mm, font=\small},
  new/.style={box, very thick, fill=blue!8},
  ext/.style={box, dashed},
  arr/.style={-{Latex[length=2mm]}, thick},
  lbl/.style={font=\scriptsize, align=center}
]
\node[ext] (prod) {producer\\(HIVE host, core\_cpp tool)};
\node[box, right=10mm of prod] (enc) {\texttt{cbor\_writer::}\\\texttt{encode\_compiled}};
\node[new, right=10mm of enc] (msgs) {\texttt{encode\_snapshot\_}\\\texttt{messages}};
\node[ext, right=10mm of msgs] (wire) {transport\\(Zenoh, UART link)};

\node[box, below=16mm of wire] (val) {\texttt{ir\_stream::}\\\texttt{validate\_message}};
\node[box, left=10mm of val] (asm) {\texttt{TransactionAssembler}\\Begin/Chunk/Commit};
\node[new, left=10mm of asm] (dec) {\texttt{decode\_snapshot}\\kind, sections, length};
\node[box, left=10mm of dec] (cbor) {\texttt{cbor\_writer::decode}\\preflight, validate, hash};

\node[ext, below=14mm of cbor] (cons) {\texttt{DecodedCborPayload}\\to HIVE store / MCU view};
\node[new, below=14mm of asm, text width=52mm] (kind) {\texttt{SectionKind::CanonicalIrCbor}\\wire 11, Raw8, repeatable, critical};

\draw[arr] (prod) -- (enc);
\draw[arr] (enc) -- node[lbl, above]{CBOR} (msgs);
\draw[arr] (msgs) -- node[lbl, above]{messages} (wire);
\draw[arr] (wire) -- node[lbl, right]{bytes} (val);
\draw[arr] (val) -- node[lbl, above]{validated} (asm);
\draw[arr] (asm) -- node[lbl, above]{committed} (dec);
\draw[arr] (dec) -- node[lbl, above]{document} (cbor);
\draw[arr] (cbor) -- (cons);
\draw[dashed] (kind) -- (asm);
\draw[dashed] (kind.west) -| (dec.south);
\draw[dashed] (kind.east) -| (val.south);
\end{tikzpicture}
