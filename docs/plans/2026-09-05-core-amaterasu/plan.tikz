\begin{tikzpicture}[node distance=10mm, every node/.style={draw,rounded corners,align=center,font=\small}, >={Latex}]
\node (source) {Clean Core revision\\Cargo.lock + canonical fixtures};
\node (sdk) [below=of source] {Pinned Rust SDK\\ephemeral SSH dependency fetch};
\node (verify) [below=of sdk] {Offline Core verification\\CLI, CBOR, release tests, fmt, Clippy};
\node (evidence) [below=of verify] {Image identity + test logs\\resource peaks + report};
\node (consumer) [right=8mm of verify,text width=40mm] {Next: locked consumers\\browser integration\\measured consumer use};
\draw[->] (source)--(sdk);
\draw[->] (sdk)--(verify);
\draw[->] (verify)--(evidence);
\draw[->,dashed] (verify)--(consumer);
\end{tikzpicture}
