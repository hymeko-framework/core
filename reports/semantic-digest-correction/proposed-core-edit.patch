+#[test]
+fn v2_values_remain_distinct_across_former_depth_boundary() {
+    for depth in [0, 1, 63, 64, 65, 128, 256] {
+        let nested = |leaf| (0..depth).fold(ValueR::Num(leaf), |v, _| ValueR::List(vec![v]));
+        let left = program(Some(nested(1.0)));
+        let right = program(Some(nested(2.0)));
+        assert_changed(&left.ir, &right.ir, "nested leaf");
+        assert_ne!(v2(&left), v2(&right), "depth {depth}");
+    }
+}
