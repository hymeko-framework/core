// WebXR semantic vocabulary — declarative meaning only, no runtime handles.
//
// Two layers, in the meta_kinematics style:
//   meta{}      — a CogInfoCom-inspired abstract top (authored): a scene is a set of
//                 cognitive entities exchanging information over channels within spatial frames.
//   elements{}  — X3D / WebXR concrete kinds, each <isa> one meta kind. These mirror the ISO X3D
//                 declarative node taxonomy and the WebXR Device API's *declarative* counterparts
//                 (reference space, anchor, input source) — NOT XRSession/XRSpace/XRAnchor runtime
//                 handles, which never enter the Ir.
//
// The canonical truth is the compiled hymeko_core::ir::Ir; this file only declares vocabulary.
webxr_vocabulary {}

xr {
    // Units the scene is measured in (inheritable, self-describing).
    units {
        length "meter";
        angle  "radian";
        time   "second";
    }

    // --- CogInfoCom-inspired abstract top (authored) ---
    meta {
        cognitive_entity {}                              // the root abstraction
        spatial_frame: + <isa> cognitive_entity {}       // establishes or occupies space
        perceptual:    + <isa> cognitive_entity {}       // carries perceivable content
        channel:       + <isa> cognitive_entity {}       // a CogInfoCom information channel
    }

    // --- X3D / WebXR concrete kinds (each inherits one meta kind) ---
    elements {
        // spatial frames — X3D grouping/Transform; WebXR reference space & anchors
        node:            meta.spatial_frame {}                        // X3D Transform / grouping node
        reference_space: meta.spatial_frame { type "local-floor"; }   // WebXR XRReferenceSpace (semantic)
        anchor:          meta.spatial_frame {}                        // spatial anchor (semantic)

        // perceivable content — X3D Shape (geometry + appearance), lights
        geometry:        meta.perceptual { primitive "box"; }         // X3D Geometry
        appearance:      meta.perceptual {}                           // X3D Appearance / material
        light:           meta.perceptual { type "directional"; }      // X3D / glTF light

        // channels (CogInfoCom) — observation and interaction
        viewpoint:       meta.channel {}                              // X3D Viewpoint = observation channel
        input_source:    meta.channel { handedness "none"; }          // WebXR input source = interaction channel
    }
}
