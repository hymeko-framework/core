// WebXR demo scene — a minimal but complete scene expressed in the webxr vocabulary.
// The reference space is the spatial root; every object is nested within it (spatial containment).
webxr_scene_demo {
    @"webxr_vocabulary.hymeko";
    using webxr_vocabulary.xr.elements as e;
}

scene {
    stage: e.reference_space {
        type "local-floor";

        // a visible box
        cube: e.node {
            geometry:   e.geometry   { primitive "box"; }
            appearance: e.appearance { color "0.8 0.2 0.2"; }
        }

        // a sphere with a spatial anchor nested inside the reference space
        marker: e.node {
            geometry:   e.geometry   { primitive "sphere"; }
            appearance: e.appearance { color "0.2 0.4 0.9"; }
            hold: e.anchor {}
        }

        // observation channel (viewpoint) and an emission channel (light)
        camera: e.viewpoint { position "0.0 1.6 3.0"; }
        sun:    e.light     { type "directional"; }

        // interaction channel: a right-hand input source
        right_hand: e.input_source { handedness "right"; }
    }
}
