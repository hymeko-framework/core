    @shoulder_l: meta_kinematics.kinematics.rev_joint { (+ shoulder_roll_link_l [[0, 0, 0], [0.0, 0.0, 0.0]], - upper_arm_l, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -160; limit_upper 60; limit_effort 65; limit_velocity 5.0; }
    @elbow_l: meta_kinematics.kinematics.rev_joint { (+ upper_arm_l [[0, 0, -0.3], [0.0, 0.0, 0.0]], - forearm_l, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -110; limit_upper 0; limit_effort 45; limit_velocity 5.0; }
    @forearm_roll_l: meta_kinematics.kinematics.rev_joint { (+ forearm_l [[0, 0, -0.26], [0.0, 0.0, 0.0]], - forearm_roll_link_l, - meta_kinematics.kinematics.axes.AXIS_Z); limit_lower -90; limit_upper 90; limit_effort 12; limit_velocity 5.0; }
    @wrist_roll_l: meta_kinematics.kinematics.rev_joint { (+ forearm_roll_link_l [[0, 0, 0], [0.0, 0.0, 0.0]], - wrist_roll_link_l, - meta_kinematics.kinematics.axes.AXIS_X); limit_lower -35; limit_upper 35; limit_effort 10; limit_velocity 5.0; }
    @wrist_pitch_l: meta_kinematics.kinematics.rev_joint { (+ wrist_roll_link_l [[0, 0, -0.01], [0.0, 0.0, 0.0]], - hand_l, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -70; limit_upper 70; limit_effort 10; limit_velocity 5.0; }
    @hip_yaw_r: meta_kinematics.kinematics.rev_joint { (+ pelvis [[0, -0.105, -0.08], [0.0, 0.0, 0.0]], - hip_yaw_link_r, - meta_kinematics.kinematics.axes.AXIS_Z); limit_lower -45; limit_upper 45; limit_effort 100; limit_velocity 5.0; }
    @hip_roll_r: meta_kinematics.kinematics.rev_joint { (+ hip_yaw_link_r [[0, 0, 0], [0.0, 0.0, 0.0]], - hip_roll_link_r, - meta_kinematics.kinematics.axes.AXIS_X); limit_lower -35; limit_upper 45; limit_effort 150; limit_velocity 5.0; }
    @hip_r: meta_kinematics.kinematics.rev_joint { (+ hip_roll_link_r [[0, 0, 0], [0.0, 0.0, 0.0]], - thigh_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -100; limit_upper 40; limit_effort 180; limit_velocity 5.0; }
    @knee_r: meta_kinematics.kinematics.rev_joint { (+ thigh_r [[0, 0, -0.4], [0.0, 0.0, 0.0]], - shin_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -5; limit_upper 135; limit_effort 180; limit_velocity 5.0; }
    @ankle_roll_r: meta_kinematics.kinematics.rev_joint { (+ shin_r [[0, 0, -0.4], [0.0, 0.0, 0.0]], - ankle_roll_link_r, - meta_kinematics.kinematics.axes.AXIS_X); limit_lower -25; limit_upper 25; limit_effort 90; limit_velocity 5.0; }
    @ankle_r: meta_kinematics.kinematics.rev_joint { (+ ankle_roll_link_r [[0, 0, -0.01], [0.0, 0.0, 0.0]], - foot_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -35; limit_upper 35; limit_effort 120; limit_velocity 5.0; }
    @toe_flex_r: meta_kinematics.kinematics.rev_joint { (+ foot_r [[0.165, 0, -0.055], [0.0, 0.0, 0.0]], - toe_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -20; limit_upper 45; limit_effort 30; limit_velocity 5.0; }
    @shoulder_yaw_r: meta_kinematics.kinematics.rev_joint { (+ torso [[0, -0.231, 0.34], [0.0, 0.0, 0.0]], - shoulder_yaw_link_r, - meta_kinematics.kinematics.axes.AXIS_Z); limit_lower -90; limit_upper 90; limit_effort 50; limit_velocity 5.0; }
    @shoulder_roll_r: meta_kinematics.kinematics.rev_joint { (+ shoulder_yaw_link_r [[0, 0, 0], [0.0, 0.0, 0.0]], - shoulder_roll_link_r, - meta_kinematics.kinematics.axes.AXIS_X); limit_lower -100; limit_upper 100; limit_effort 65; limit_velocity 5.0; }
    @shoulder_r: meta_kinematics.kinematics.rev_joint { (+ shoulder_roll_link_r [[0, 0, 0], [0.0, 0.0, 0.0]], - upper_arm_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -160; limit_upper 60; limit_effort 65; limit_velocity 5.0; }
    @elbow_r: meta_kinematics.kinematics.rev_joint { (+ upper_arm_r [[0, 0, -0.3], [0.0, 0.0, 0.0]], - forearm_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -110; limit_upper 0; limit_effort 45; limit_velocity 5.0; }
    @forearm_roll_r: meta_kinematics.kinematics.rev_joint { (+ forearm_r [[0, 0, -0.26], [0.0, 0.0, 0.0]], - forearm_roll_link_r, - meta_kinematics.kinematics.axes.AXIS_Z); limit_lower -90; limit_upper 90; limit_effort 12; limit_velocity 5.0; }
    @wrist_roll_r: meta_kinematics.kinematics.rev_joint { (+ forearm_roll_link_r [[0, 0, 0], [0.0, 0.0, 0.0]], - wrist_roll_link_r, - meta_kinematics.kinematics.axes.AXIS_X); limit_lower -35; limit_upper 35; limit_effort 10; limit_velocity 5.0; }
    @wrist_pitch_r: meta_kinematics.kinematics.rev_joint { (+ wrist_roll_link_r [[0, 0, -0.01], [0.0, 0.0, 0.0]], - hand_r, - meta_kinematics.kinematics.axes.AXIS_Y); limit_lower -70; limit_upper 70; limit_effort 10; limit_velocity 5.0; }
    elbow_muscle { law "muscle"; force_n 800.0; activation_s 0.015; deactivation_s 0.05; length_min_m 0.10; length_max_m 0.48; radius_m 0.018; }
    knee_cylinder { law "hydraulic"; area_m2 0.00045; pressure_pa 8000000.0; response_s 0.04; damping_ns_m 60.0; length_min_m 0.10; length_max_m 0.48; radius_m 0.022; }
    ankle_cylinder { law "hydraulic"; area_m2 0.00030; pressure_pa 8000000.0; response_s 0.04; damping_ns_m 60.0; length_min_m 0.15; length_max_m 0.42; radius_m 0.018; }
    @flexor_l: meta_kinematics.kinematics.muscle_drive { (+ upper_arm_l.flexor_origin, - forearm_l.flexor_insertion); joint -> elbow_l; parameters -> elbow_muscle; }
    @extensor_l: meta_kinematics.kinematics.muscle_drive { (+ upper_arm_l.extensor_origin, - forearm_l.extensor_insertion); joint -> elbow_l; parameters -> elbow_muscle; wrap -> upper_arm_l.elbow_guide; side -> upper_arm_l.extensor_side; }
    @knee_cylinder_l: meta_kinematics.kinematics.hydraulic_drive { (+ thigh_l.cylinder_mount, - shin_l.knee_rod); joint -> knee_l; parameters -> knee_cylinder; }
    @ankle_cylinder_l: meta_kinematics.kinematics.hydraulic_drive { (+ shin_l.ankle_mount, - foot_l.ankle_rod); joint -> ankle_l; parameters -> ankle_cylinder; }
    @flexor_r: meta_kinematics.kinematics.muscle_drive { (+ upper_arm_r.flexor_origin, - forearm_r.flexor_insertion); joint -> elbow_r; parameters -> elbow_muscle; }
    @extensor_r: meta_kinematics.kinematics.muscle_drive { (+ upper_arm_r.extensor_origin, - forearm_r.extensor_insertion); joint -> elbow_r; parameters -> elbow_muscle; wrap -> upper_arm_r.elbow_guide; side -> upper_arm_r.extensor_side; }
    @knee_cylinder_r: meta_kinematics.kinematics.hydraulic_drive { (+ thigh_r.cylinder_mount, - shin_r.knee_rod); joint -> knee_r; parameters -> knee_cylinder; }
    @ankle_cylinder_r: meta_kinematics.kinematics.hydraulic_drive { (+ shin_r.ankle_mount, - foot_r.ankle_rod); joint -> ankle_r; parameters -> ankle_cylinder; }

    // TP scheduling groups; the physical body model remains unchanged.
    tp_leg_l_0: meta_kinematics.kinematics.elements.tp_axis { joint -> hip_l; lower_deg -20; upper_deg 20; }
    tp_leg_l_1: meta_kinematics.kinematics.elements.tp_axis { joint -> knee_l; lower_deg 5; upper_deg 50; }
    @tp_leg_l: meta_kinematics.kinematics.tp_chart { (+ tp_leg_l_0, + tp_leg_l_1); operator "rest_acceleration"; samples 11; rank 3; cr_grid 257; }
    tp_leg_r_0: meta_kinematics.kinematics.elements.tp_axis { joint -> hip_r; lower_deg -20; upper_deg 20; }
    tp_leg_r_1: meta_kinematics.kinematics.elements.tp_axis { joint -> knee_r; lower_deg 5; upper_deg 50; }
    @tp_leg_r: meta_kinematics.kinematics.tp_chart { (+ tp_leg_r_0, + tp_leg_r_1); operator "rest_acceleration"; samples 11; rank 3; cr_grid 257; }
    tp_arm_l_0: meta_kinematics.kinematics.elements.tp_axis { joint -> shoulder_l; lower_deg -30; upper_deg 0; }
    tp_arm_l_1: meta_kinematics.kinematics.elements.tp_axis { joint -> elbow_l; lower_deg -90; upper_deg -10; }
    @tp_arm_l: meta_kinematics.kinematics.tp_chart { (+ tp_arm_l_0, + tp_arm_l_1); operator "rest_acceleration"; samples 11; rank 3; cr_grid 257; }
    tp_arm_r_0: meta_kinematics.kinematics.elements.tp_axis { joint -> shoulder_r; lower_deg -30; upper_deg 0; }
    tp_arm_r_1: meta_kinematics.kinematics.elements.tp_axis { joint -> elbow_r; lower_deg -90; upper_deg -10; }
    @tp_arm_r: meta_kinematics.kinematics.tp_chart { (+ tp_arm_r_0, + tp_arm_r_1); operator "rest_acceleration"; samples 11; rank 3; cr_grid 257; }

    // Ideal rectified stereo add-on; no hardware-identification claim.
    stereo_left: meta_kinematics.kinematics.sensors.rgb_camera {
        camera_id 210; optical_frame "humanoid.head.left_optical";
        width 320; height 240; fovy_deg 60; update_rate 5;
        clip [0.02, 20.0]; position [0.105, 0.06, 0.1];
        xy_axes [0, -1, 0, 0, 0, 1];
    }
    @stereo_left_mount: meta_kinematics.kinematics.sensors.sensor_connection {
        (+ stereo_left, - head);
    }
    stereo_right: meta_kinematics.kinematics.sensors.rgb_camera {
        camera_id 211; optical_frame "humanoid.head.right_optical";
        width 320; height 240; fovy_deg 60; update_rate 5;
        clip [0.02, 20.0]; position [0.105, -0.06, 0.1];
        xy_axes [0, -1, 0, 0, 0, 1];
    }
    @stereo_right_mount: meta_kinematics.kinematics.sensors.sensor_connection {
        (+ stereo_right, - head);
    }
    @head_stereo: meta_kinematics.kinematics.sensors.stereo_pair { (+ stereo_left, - stereo_right); }
}
