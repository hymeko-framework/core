#!/bin/sh
# Contract gate, pre-commit half. Install with tools/hooks/install.sh.
#
# Three checks, in rising order of cost:
#
#   1. SYMBOLS.md is not stale.
#   2. Duplication has not increased against .duplication-baseline.json.
#   3. Every added file is run past the preflight, and the candidates are PRINTED.
#
# Only the first two block here. The third does not, and the reason is measured
# rather than assumed: at pre-commit time `.git/COMMIT_EDITMSG` still holds the
# PREVIOUS commit's message. A gate that blocked here with a "unless the message
# says DISCOVERY:" escape would read the wrong message — and worse, would fail
# OPEN whenever the last commit happened to carry that word. So the blocking half
# of the preflight lives in `commit-msg`, where the message arrives as $1, and
# this half prints early so the candidates are on screen before the editor opens.
#
# POSIX sh. Degrades to a warning rather than a block when python3 is unusable.

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

# The hook console is not UTF-8 on Windows, and the scripts print em-dashes.
# Without this the first blocking message a person ever sees is mojibake.
export PYTHONIOENCODING=utf-8

# Finding an interpreter is not one line. On this host `command -v python3` finds
# the Microsoft Store shim, which answers `command -v` and then exits 49 without
# running anything, while the real interpreter is `python3.14`. So each candidate
# is PROBED by running it, versioned names are tried after the generic ones, and
# CONTRACT_PYTHON overrides the lot. Without this the hooks installed cleanly and
# silently enforced nothing — which was observed, not imagined.
PYTHON="${CONTRACT_PYTHON:-}"
if [ -n "$PYTHON" ] && ! "$PYTHON" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    echo "contract hooks: CONTRACT_PYTHON=$PYTHON does not run." >&2
    PYTHON=""
fi
if [ -z "$PYTHON" ]; then
    for candidate in python3 python py python3.14 python3.13 python3.12 python3.11; do
        if command -v "$candidate" >/dev/null 2>&1 \
           && "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    echo "contract hooks: no usable python3 — checks skipped, not failed." >&2
    exit 0
fi

fail=0

if ! "$PYTHON" tools/gen_symbols.py --check; then
    echo >&2
    echo "  SYMBOLS.md is stale. Run:  $PYTHON tools/gen_symbols.py  and stage it." >&2
    fail=1
fi

if [ -f .duplication-baseline.json ]; then
    if ! "$PYTHON" tools/duplication_gate.py; then
        echo >&2
        echo "  Duplication rose. Consolidate, or justify the rise and run --update." >&2
        fail=1
    fi
fi

# Added files only: a modified file is not a new artifact.
set --
while IFS= read -r path; do
    [ -n "$path" ] && set -- "$@" "$path"
done <<ADDED
$(git diff --cached --diff-filter=A --name-only)
ADDED

if [ "$#" -gt 0 ]; then
    echo
    "$PYTHON" tools/preflight_new_artifact.py "$@" || true
    echo
    echo "  (advisory here — commit-msg blocks unless the message carries a DISCOVERY: line)"
fi

exit "$fail"
