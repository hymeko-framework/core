#!/bin/sh
# Contract gate, commit-msg half. Install with tools/hooks/install.sh.
#
# This is where the preflight blocks, because this is the first hook that can see
# the message: git passes the file as $1. `pre-commit` cannot -- at that point
# `.git/COMMIT_EDITMSG` still holds the previous commit's message, so a bypass
# read there would match the wrong commit and fail open. Verified on git 2.55.0.
#
# A commit that adds a file resembling something that already exists is refused
# until the message carries a line beginning `DISCOVERY:` -- §6.6's ledger, in the
# one place git will preserve it. The rule was never that a new artifact is
# forbidden, only that the search must be visible.

set -u

SPEC="git+ssh://git@192.168.1.228:2222/hymeko/hymeko.git@e6d83977978f198f509d448ac8121deed3af0aee"

MESSAGE_FILE="${1:-}"
[ -n "$MESSAGE_FILE" ] || exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

export PYTHONIOENCODING=utf-8

if ! command -v uv >/dev/null 2>&1; then
    echo "contract hooks: uv not found — required preflight cannot run." >&2
    exit 1
fi

# Resolve the declared revision; another repository's global tool installation
# must not silently replace this checkout's verification contract.
gate() { uv tool run --quiet --from "$SPEC" "$@"; }

set --
while IFS= read -r path; do
    [ -n "$path" ] && set -- "$@" --path "$path"
done <<ADDED
$(git diff --cached --diff-filter=A --name-only)
ADDED

[ "$#" -gt 0 ] || exit 0

gate contract-preflight --root . "$@" >/dev/null 2>&1
status=$?
case "$status" in
    0) exit 0 ;;
    1) ;;  # discovery candidates may be justified in the message
    *) echo "contract preflight failed to execute (exit $status); cannot bypass with DISCOVERY:" >&2
       exit 1 ;;
esac

if grep -qE '^[[:space:]]*DISCOVERY:' "$MESSAGE_FILE"; then
    exit 0
fi

echo >&2
gate contract-preflight --root . "$@" >&2
cat >&2 <<'WHY'

  This commit adds a file resembling something that already exists.

  Extend the existing one, or record the search in the commit message — a line
  beginning DISCOVERY: naming what you rejected and why. One sentence. "Not
  quite the same" is not a reason; name the differing invariant, owner or
  contract (§6.6).

    DISCOVERY: rejected hymeko_pgraph because it owns the P-graph schema, and
    this is the hypergraph lowering that consumes it.

WHY
exit 1
